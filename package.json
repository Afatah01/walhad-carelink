{
  "name": "walhad-carelink",
  "version": "1.0.0",
  "private": true,
  "description": "Walhad CareLink - Premium FreeStyle Libre glucose monitoring and family alert platform",
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p ${PORT:-3000}",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p ${PORT:-3000}",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/migrate.mts",
    "db:seed": "tsx scripts/seed.mts",
    "sync:demo": "tsx scripts/sync-demo.mts",
    "telegram:set-webhook": "tsx scripts/telegram-set-webhook.mts",
    "test": "node --test --import tsx tests/*.test.ts",
    "render:provision": "node scripts/provision-render.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^11.10.0",
    "next": "15.5.28",
    "pg": "^8.23.1",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "recharts": "^3.2.1",
    "web-push": "^3.6.7",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.14",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.18.8",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@types/web-push": "^3.6.4",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.20.6",
    "typescript": "5.9.3"
  }
}
