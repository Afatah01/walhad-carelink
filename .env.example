# ─────────────────────────────────────────────────────────────────────────────
# Walhad CareLink — environment template
# Copy to .env for local development. On Render.com set these as service
# environment variables (never commit a real .env).
# ─────────────────────────────────────────────────────────────────────────────

# Public base URL. Must be HTTPS in production (Telegram webhooks require it).
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_BASE_URL=http://localhost:3000

# Secret used to sign session cookies and encrypt stored provider credentials.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=replace-with-a-64-character-random-string

# ── Database ────────────────────────────────────────────────────────────────
# Leave empty for the zero-config SQLite file (local/dev only).
# On Render, set DATABASE_URL to the Internal Database URL of a Postgres instance.
DATABASE_URL=
# Path for the SQLite fallback (default: ~/.walhad-data/walhad-carelink.db)
SQLITE_PATH=
PGSSL=true
PG_POOL_MAX=6

# ── Demo workspace ──────────────────────────────────────────────────────────
# Seeds an organisation, staff and eight demo patients on first boot.
# Set to false for a real deployment.
SEED_DEMO=true
DEMO_PASSWORD=CareLink2026!
# How old demo readings may get before the next request refreshes them.
# The app has no cron on Render's free tier, so it syncs itself on wake-up.
DEMO_REFRESH_MINUTES=10

# ── Abbott FreeStyle Libre integration (partner credentials, optional) ──────
# The official LibreView API requires Abbott partner onboarding. Until those
# credentials are issued, the app runs on the demo provider and the
# LibreLinkUp consent flow — it never stores a patient's Libre password.
LIBREVIEW_API_BASE=
LIBREVIEW_CLIENT_ID=
LIBREVIEW_CLIENT_SECRET=
LIBREVIEW_TOKEN_PATH=
LIBREVIEW_GRAPH_PATH=
LIBREVIEW_SCOPE=
LINKUP_API_BASE=https://api.libreview.io
LINKUP_ACCOUNT_ID=

# ── Telegram bot ────────────────────────────────────────────────────────────
# Create a bot with @BotFather, then set the token here and register the
# webhook with: npm run telegram:set-webhook
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Optional: auto-generated and stored in the database when omitted.
TELEGRAM_WEBHOOK_SECRET=

# ── SMS (optional; Telegram + push work without it) ─────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Or any HTTP SMS gateway taking a JSON POST
SMS_HTTP_URL=
SMS_HTTP_TOKEN=

# ── Web push (optional) ─────────────────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:alerts@example.com

# ── Payments (modular providers) ────────────────────────────────────────────
# A subscription only becomes active after a verified provider confirmation.
PAYMENT_CHECKOUT_URL=
PAYMENT_WEBHOOK_SECRET=

# ── Scheduled jobs ──────────────────────────────────────────────────────────
# Secret for GET /api/cron/sync (falls back to APP_SECRET when unset).
# Cron jobs are a paid Render feature — see DEPLOY.md for the free-tier
# alternative (lazy sync on wake + .github/workflows/keepalive.yml).
CRON_SECRET=

# ── Public contact details (left blank = hidden, never invented) ────────────
CONTACT_EMAIL=
CONTACT_PHONE=
CONTACT_ADDRESS=
CONTACT_HOURS=

# ── Optional outbound email ─────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=
AUTH_SECRET=
